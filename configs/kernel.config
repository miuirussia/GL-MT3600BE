# Build these capabilities into Linux instead of loading them as modules.

# Connection tracking, events, and labels.
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_CONNTRACK_LABELS=y

# Netfilter egress and traffic-control actions.
CONFIG_NETFILTER_EGRESS=y
CONFIG_NET_CLS_ACT=y

# XFRM_USER selects the hidden XFRM core and its algorithm support.
CONFIG_XFRM=y
CONFIG_XFRM_USER=y

# Kernel TLS and device offload support.
CONFIG_TLS=y
CONFIG_TLS_DEVICE=y

# Network filesystem cache core.
CONFIG_NETFS_SUPPORT=y
CONFIG_FSCACHE=y

# Match the official 8250 UART limits.
CONFIG_SERIAL_8250_EXTENDED=y
CONFIG_SERIAL_8250_MANY_PORTS=y
# CONFIG_SERIAL_8250_SHARE_IRQ is not set
CONFIG_SERIAL_8250_NR_UARTS=16
CONFIG_SERIAL_8250_RUNTIME_UARTS=16

# Expose the running kernel configuration at /proc/config.gz.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
