# Packages to include in the image; use =m to build a separate APK instead.
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_LUCI_LANG_ru=y
CONFIG_PACKAGE_luci-i18n-base-ru=y
# Runtime dependencies of the prebuilt luci-theme-outline APK in apk/.
CONFIG_PACKAGE_rpcd-mod-ucode=y
CONFIG_PACKAGE_ucode-mod-fs=y
CONFIG_PACKAGE_ucode-mod-uci=y
CONFIG_PACKAGE_uclient-fetch=y
CONFIG_PACKAGE_jsonfilter=y
# Integrate nft tproxy
CONFIG_PACKAGE_kmod-nft-tproxy=y
