Subject: [PATCH] mt76: add the mt7996 TXD workaround from issue 1043

Install the driver patch after the upstream mt76 patch series.

--- /dev/null
+++ b/package/kernel/mt76/patches/9999-routerfw-mt7996-always-apply-txd.patch
@@ -0,0 +1,36 @@
+From: kyoto44
+Subject: [PATCH] wifi: mt76: mt7996: always fill and apply TXD
+
+Avoid incorrect firmware header processing and slow IPv4 NAT downloads
+over Wi-Fi. Adapt the issue patch to retain the current link_id argument.
+
+Source: https://github.com/openwrt/mt76/issues/1043#issuecomment-4414905981
+
+--- a/mt7996/mac.c
++++ b/mt7996/mac.c
+@@ -1128,10 +1128,9 @@
+ 
+ 	pid = mt76_tx_status_skb_add(mdev, wcid, tx_info->skb);
+ 	memset(txwi_ptr, 0, MT_TXD_SIZE);
+-	/* Transmit non qos data by 802.11 header and need to fill txd by host*/
+-	if (!is_8023 || pid >= MT_PACKET_ID_FIRST)
+-		mt7996_mac_write_txwi(dev, txwi_ptr, tx_info->skb, wcid, key,
+-				      pid, qid, 0, link_id);
++	/* Always fill txwi for firmware to avoid incorrect header processing */
++	mt7996_mac_write_txwi(dev, txwi_ptr, tx_info->skb, wcid, key,
++			      pid, qid, 0, link_id);
+ 
+ 	/* MT7996 and MT7992 require driver to provide the MAC TXP for AddBA
+ 	 * req
+@@ -1180,9 +1179,8 @@
+ 		txp->fw.nbuf = nbuf;
+ 
+ 		txp->fw.flags = cpu_to_le16(MT_CT_INFO_FROM_HOST);
+-
+-		if (!is_8023 || pid >= MT_PACKET_ID_FIRST)
+-			txp->fw.flags |= cpu_to_le16(MT_CT_INFO_APPLY_TXD);
++		/* Always apply TXD to ensure correct firmware processing */
++		txp->fw.flags |= cpu_to_le16(MT_CT_INFO_APPLY_TXD);
+ 
+ 		if (!key)
+ 			txp->fw.flags |= cpu_to_le16(MT_CT_INFO_NONE_CIPHER_FRAME);
