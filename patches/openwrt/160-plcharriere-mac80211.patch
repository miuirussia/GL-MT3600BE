+ 	if (wdev) {
+ 		sdata = IEEE80211_WDEV_TO_SUB_IF(wdev);
+ 
+@@ -4574,10 +4610,21 @@ static int ieee80211_set_antenna(struct wiphy *wiphy, int radio_idx,
