+ static int handle_coverage(struct nl80211_state *state,
+ 			struct nl_msg *msg,
+ 			int argc, char **argv,
+ 			enum id_input id)
+ {
+ 	char *end;
+ 	unsigned int coverage;
+ 
+-	if (argc != 1)
++	if (argc != 1 && argc != 3)
+ 		return 1;
+ 
+ 	if (!*argv[0])
+ 		return 1;
+ 	coverage = strtoul(argv[0], &end, 10);
+ 	if (coverage > 255)
+ 		return 1;
+ 
+ 	if (*end)
+ 		return 1;
+ 
+ 	NLA_PUT_U8(msg, NL80211_ATTR_WIPHY_COVERAGE_CLASS, coverage);
+ 
+-	return 0;
+- nla_put_failure:
