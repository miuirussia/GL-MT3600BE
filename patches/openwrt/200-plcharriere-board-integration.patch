--- /dev/null
+++ b/target/linux/mediatek/filogic/base-files/etc/hotplug.d/iface/90-led-online
@@ -0,0 +1,25 @@
+#!/bin/sh
+
+case "$ACTION" in
+ifup|ifdown|ifupdate) ;;
+*) exit 0 ;;
+esac
+
+/etc/init.d/led enabled || exit 0
+
+. /lib/functions.sh
+
+update_led() {
+	local sysfs trigger
+
+	config_get trigger "$1" trigger
+	case "$trigger" in
+	online|offline)
+		config_get sysfs "$1" sysfs
+		/etc/init.d/led start "$sysfs"
+		;;
+	esac
+}
+
+config_load system
+config_foreach update_led led
diff --git a/target/linux/mediatek/filogic/base-files/etc/uci-defaults/10_gl-mt3600be-wifi-tx-burst b/target/linux/mediatek/filogic/base-files/etc/uci-defaults/10_gl-mt3600be-wifi-tx-burst
new file mode 100644
--- /dev/null
+++ b/target/linux/mediatek/filogic/base-files/etc/uci-defaults/10_gl-mt3600be-wifi-tx-burst
@@ -0,0 +1,26 @@
+. /lib/functions.sh
+
+[ "$(board_name)" = "glinet,gl-mt3600be" ] || exit 0
+
+tx_burst_changed=0
+
+set_5ghz_tx_burst() {
+	local section="$1"
+	local band burst
+
+	config_get band "$section" band
+	[ "$band" = "5g" ] || return
+
+	config_get burst "$section" tx_queue_data2_burst
+	[ -n "$burst" ] && return
+
+	uci set "wireless.${section}.tx_queue_data2_burst=4.0" || exit 1
+	tx_burst_changed=1
+}
+
+config_load wireless
+config_foreach set_5ghz_tx_burst wifi-device
+
+[ "$tx_burst_changed" -eq 0 ] || uci commit wireless || exit 1
+
+exit 0
diff --git a/target/linux/mediatek/filogic/base-files/etc/uci-defaults/11_gl-mt3600be-dns-dscp b/target/linux/mediatek/filogic/base-files/etc/uci-defaults/11_gl-mt3600be-dns-dscp
new file mode 100644
--- /dev/null
+++ b/target/linux/mediatek/filogic/base-files/etc/uci-defaults/11_gl-mt3600be-dns-dscp
@@ -0,0 +1,29 @@
+. /lib/functions.sh
+
+[ "$(board_name)" = "glinet,gl-mt3600be" ] || exit 0
+
+dns_rule_found=0
+
+find_dns_rule() {
+	local name
+
+	config_get name "$1" name
+	[ "$name" = "DNS-answers-VI" ] && dns_rule_found=1
+}
+
+config_load firewall
+config_foreach find_dns_rule rule
+
+[ "$dns_rule_found" -eq 0 ] || exit 0
+
+uci -q batch > /dev/null <<-EOT
+	add firewall rule
+	set firewall.@rule[-1].name='DNS-answers-VI'
+	set firewall.@rule[-1].proto='tcp udp'
+	set firewall.@rule[-1].src_port='53'
+	set firewall.@rule[-1].target='DSCP'
+	set firewall.@rule[-1].set_dscp='CS5'
+	commit firewall
+EOT
+
+exit $?
diff --git a/target/linux/mediatek/filogic/base-files/etc/uci-defaults/12_gl-mt3600be-flow-offload b/target/linux/mediatek/filogic/base-files/etc/uci-defaults/12_gl-mt3600be-flow-offload
new file mode 100644
--- /dev/null
+++ b/target/linux/mediatek/filogic/base-files/etc/uci-defaults/12_gl-mt3600be-flow-offload
@@ -0,0 +1,16 @@
+. /lib/functions.sh
+
+[ "$(board_name)" = "glinet,gl-mt3600be" ] || exit 0
+
+# keep any flow offloading setting, and SQM, which hardware offloading bypasses
+[ -z "$(uci -q get firewall.@defaults[0].flow_offloading)" ] || exit 0
+[ -z "$(uci -q get firewall.@defaults[0].flow_offloading_hw)" ] || exit 0
+uci -q show sqm | grep -q "\.enabled='1'$" && exit 0
+
+uci -q batch <<-EOT
+	set firewall.@defaults[0].flow_offloading='1'
+	set firewall.@defaults[0].flow_offloading_hw='1'
+	commit firewall
+EOT
+
+exit $?
