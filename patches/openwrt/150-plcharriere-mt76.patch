+ 
+ #else
+ 
+-#define Q_READ(_q, _field)		readl(&(_q)->regs->_field)
+-#define Q_WRITE(_q, _field, _val)	writel(_val, &(_q)->regs->_field)
++#define __Q_READ(_q, _field)		readl(&(_q)->regs->_field)
++#define __Q_WRITE(_q, _field, _val)	writel(_val, &(_q)->regs->_field)
+ 
+ #endif
+ 
++#define Q_READ(_q, _field, _mask) ({ \
++	u32 _q_value = __Q_READ(_q, _field); \
++	(_mask) ? FIELD_GET(_mask, _q_value) : _q_value; \
++})
++
++#define Q_WRITE(_q, _field, _value, _mask) do { \
++	u32 _q_value = __Q_READ(_q, _field); \
++	_q_value = (_q_value & ~(_mask)) | FIELD_PREP(_mask, _value); \
